{
  "manifest_version": 3,
  "name": "tabcat",
  "short_name": "tabcat",
  "version": "1.0.3",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "tabcat",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "alarms",
    "favicon",
    "tabGroups"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "__MSG_cmdPopup__"
    },
    "open-dashboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "__MSG_cmdDashboard__"
    },
    "save-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdSaveTab__"
    },
    "save-window": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "__MSG_cmdSaveWindow__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://tabcat.ghyeok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://tabcat.ghyeok.com/*"
      ]
    }
  ]
}
